# Wololo Converter Backend Configuration

# Server settings
DEBUG=false
HOST=0.0.0.0
PORT=47652
# Minimum mobile app version accepted by the client compatibility check
MIN_APP_VERSION=1.0.0

# File storage
TEMP_DIR=/tmp/wololo
MAX_FILE_AGE_HOURS=1
CLEANUP_INTERVAL_MINUTES=15

# Download settings
MAX_CONCURRENT_DOWNLOADS=3
# Waiting jobs in addition to the active downloads
MAX_QUEUED_DOWNLOADS=20
DOWNLOAD_TIMEOUT_SECONDS=3600
MAX_FILE_SIZE_MB=10000

# Rate limiting
RATE_LIMIT_DOWNLOADS=10/minute
# Optional named keys. Generate a different random secret for each person.
# Example format: alice:replace-with-random-secret,bob:replace-with-another-secret
# Requests without X-Wololo-Key continue to use the per-IP rate limit.
# Invalid supplied keys receive HTTP 401. Never commit real keys.
API_KEYS=

# Database
DATABASE_URL=sqlite+aiosqlite:///./wololo.db

# CORS origins (comma-separated, for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:47651
